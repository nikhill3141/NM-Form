{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Next.js App Engine",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "incremental": true,
    "declaration": false,
    "declarationMap": false,
    "lib": ["dom", "dom.iterable", "es2022"],
    "plugins": [
      {
        "name": "next"
      }
    ]
  }
}
